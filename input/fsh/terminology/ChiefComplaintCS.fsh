CodeSystem: ChiefComplaintCS
Id: west-a-chief-complaint-cs
Title: "WEST-A chief complaint"
Description: "Chief complaints (sökorsaker) of WEST-A. Each concept is one WEST-A complaint algorithm with its own warning symptoms."
* insert OriginalCodeSystemDraft
* ^copyright = "WEST-A is developed by Västra Götalandsregionen. This code system is an unofficial representation of its complaint algorithms."

* #1 "Allergi"
  * ^definition = "Allergic reactions and bites of venomous animals (WEST-A page 10)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Allergy"
* #2 "Blodtryck"
  * ^definition = "High blood pressure (WEST-A page 11)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Blood pressure"
* #3 "Blödning/anemi"
  * ^definition = "Bleeding or anemia (WEST-A page 12)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Bleeding/anemia"
* #4 "Bröstsmärta"
  * ^definition = "Chest pain (WEST-A page 13)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Chest pain"
* #5 "Buksmärta"
  * ^definition = "Abdominal pain (WEST-A page 14)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Abdominal pain"
* #6 "Diabetes"
  * ^definition = "Problems related to diabetes, such as hypo- or hyperglycemia (WEST-A page 15)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Diabetes"
* #7 "Diarré/kräkningar"
  * ^definition = "Diarrhea or vomiting (WEST-A page 16)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Diarrhea/vomiting"
* #8 "Dyspné"
  * ^definition = "Shortness of breath (WEST-A page 17)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Dyspnea"
* #9 "Extremitetsproblem"
  * ^definition = "Pain, swelling or other problems of an arm or leg (WEST-A page 18)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Limb problem"
* #10 "Graviditet fr.o.m. 18+0/post partum"
  * ^definition = "Complaints in pregnancy from week 18+0, or after delivery (WEST-A page 19)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Pregnancy from week 18+0/postpartum"
* #11 "Gynekologiska sökorsaker"
  * ^definition = "Gynecological complaints, including pregnancy up to week 17+6 (WEST-A pages 21-22)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Gynecological complaints"
* #12 "Hjärtrytm"
  * ^definition = "Abnormal heart rhythm or rate (WEST-A page 23)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Heart rhythm"
* #13 "Hjärtstopp/luftvägshinder"
  * ^definition = "Cardiac arrest or airway obstruction (WEST-A page 24)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Cardiac arrest/airway obstruction"
* #14 "Hud"
  * ^definition = "Skin problems (WEST-A page 25)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Skin"
* #15 "Huvudvärk"
  * ^definition = "Headache (WEST-A page 26)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Headache"
* #16 "Infektion/feber/sepsis"
  * ^definition = "Suspected infection, fever or sepsis (WEST-A page 27)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Infection/fever/sepsis"
* #17 "Intox"
  * ^definition = "Poisoning or overdose (WEST-A page 28)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Poisoning"
* #18 "Komplikation operation/gips"
  * ^definition = "Complication after surgery, a cast or similar treatment (WEST-A page 29)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Complication after surgery or cast"
* #19 "Leversjukdom"
  * ^definition = "Complaints in a patient with liver disease (WEST-A page 30)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Liver disease"
* #20 "Ljumske"
  * ^definition = "Groin problems, such as hernia (WEST-A page 31)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Groin"
* #21 "Medvetandepåverkan"
  * ^definition = "Reduced or altered consciousness (WEST-A page 32)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Altered consciousness"
* #22 "Neuro/yrsel/kramper"
  * ^definition = "Neurological symptoms, dizziness or seizures (WEST-A page 33)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Neurology/dizziness/seizures"
* #23 "Ospecifik sjukdom"
  * ^definition = "Illness that WEST-A triages on its own page: abnormal potassium with ECG changes, or known Addison's disease or adrenal insufficiency (WEST-A page 35)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Non-specific illness"
* #24 "Psykiska besvär"
  * ^definition = "Mental health problems (WEST-A pages 36-37)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Mental health problems"
* #25 "Rektala besvär"
  * ^definition = "Rectal problems; the WEST-A page is headed \"Rect\" and has no warning symptoms of its own (WEST-A page 38)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Rectal problems"
* #26 "Ryggsmärta"
  * ^definition = "Back pain (WEST-A page 39)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Back pain"
* #27 "Svimning"
  * ^definition = "Fainting (WEST-A page 40)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Fainting"
* #28 "Underlivsbesvär män"
  * ^definition = "Genital problems in men (WEST-A page 41)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Male genital problems"
* #29 "Urinvägsbesvär"
  * ^definition = "Urinary tract problems (WEST-A page 42)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Urinary tract problems"
* #30 "Trauma/skador"
  * ^definition = "Trauma or injuries, with or without the national trauma alert criteria (WEST-A pages 43-44)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Trauma/injuries"
* #31 "Ögon och öron"
  * ^definition = "Eye and ear problems, including swallowed foreign bodies (WEST-A page 45)."
  * ^designation[0].language = #en
  * ^designation[=].value = "Eyes and ears"
