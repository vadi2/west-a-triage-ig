// FHIR R4 core vital signs profiles
Alias: $bodytemp = http://hl7.org/fhir/StructureDefinition/bodytemp
Alias: $bp = http://hl7.org/fhir/StructureDefinition/bp
Alias: $heartrate = http://hl7.org/fhir/StructureDefinition/heartrate
Alias: $loinc = http://loinc.org
// Swedish patient identifier systems, as defined by HL7 Sweden in the SE Base profiles (hl7se.fhir.base)
Alias: $nationellt-reservnummer = http://electronichealth.se/identifier/nationelltReservnummer
Alias: $observation-category = http://terminology.hl7.org/CodeSystem/observation-category
Alias: $oxygensat = http://hl7.org/fhir/StructureDefinition/oxygensat
Alias: $personnummer = http://electronichealth.se/identifier/personnummer
Alias: $resprate = http://hl7.org/fhir/StructureDefinition/resprate
Alias: $samordningsnummer = http://electronichealth.se/identifier/samordningsnummer
Alias: $sct = http://snomed.info/sct
// The Swedish edition of SNOMED CT, for example codings with Swedish displays
Alias: $sct-se = http://snomed.info/sct|http://snomed.info/sct/45991000052106
Alias: $ucum = http://unitsofmeasure.org
Alias: $v3-ActCode = http://terminology.hl7.org/CodeSystem/v3-ActCode
// VGR Base profiles (se.vgregion.fhir.base)
Alias: $VGRBaseEncounter = https://fhir.vgregion.se/ig/base/StructureDefinition/VGRBaseEncounter
Alias: $VGRBasePatient = https://fhir.vgregion.se/ig/base/StructureDefinition/VGRBasePatient
