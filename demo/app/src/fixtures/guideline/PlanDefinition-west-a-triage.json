 "description": "The calculable part of a WEST-A triage. First NEWS2 is calculated from the vital signs; then, once the nurse has assessed the warning symptoms of the chief complaint, a triage priority is proposed, which is the most urgent of the colour of the NEWS2 clinical risk, the priority of the warning symptoms, and yellow for the needs and processes that give yellow as the lowest priority. The triage nurse records the final priority as a WEST-A Triage Observation.",
 "jurisdiction": [
  {
   "coding": [
    {
     "system": "urn:iso:std:iso:3166",
     "code": "SE",
     "display": "Sweden"
    }
   ]
  }
 ],
 "purpose": "Source: the WEST-A triage manual for adults without referral support (WEST A utan hänvisningsstöd), Västra Götalandsregionen, version 2025:02:01",
 "library": [
  "https://vadi2.github.io/west-a-triage-ig/Library/WestATriage"
 ],
 "action": [
  {
   "id": "calculate-news2",
   "title": "Calculate NEWS2",
   "description": "Calculate NEWS2 from the vital signs measured at triage",
   "definitionCanonical": "https://vadi2.github.io/west-a-triage-ig/PlanDefinition/west-a-news2-calculation"
  },
  {
   "id": "propose-priority",
   "title": "Propose the triage priority",
   "description": "When NEWS2 has been calculated and the warning symptoms of the chief complaint have been assessed, propose the most urgent of the priority from the vital parameters, the priority of the warning symptoms, and yellow for frail elderly, likely admission, or violence or sexual assault",
   "trigger": [
    {
     "type": "data-added",
